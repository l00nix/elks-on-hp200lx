@ECHO OFF
IF NOT EXIST C:\ELKS352B\K352B GOTO MISSING
C:
CD \ELKS352B
ECHO HP 200LX Release 3.5.2b - CORRECTED ELKS FIRMWARE PORT
IF NOT EXIST B352BCPY.COM GOTO MISSING
IF NOT EXIST CFEN34.COM GOTO MISSING
IF NOT EXIST HPSNAP.COM GOTO MISSING
IF NOT EXIST MKINTS.COM GOTO MISSING
IF NOT EXIST BTGVDX.COM GOTO MISSING
IF NOT EXIST ROOT092 GOTO MISSING
ECHO STEP 1: Enable CF card.
CFEN34
ECHO STEP 2: Write C:\ELKS352B\HP352B.TXT.
HPSNAP.COM > HP352B.TXT
IF ERRORLEVEL 1 GOTO SNAPFAIL
IF NOT EXIST HP352B.TXT GOTO SNAPFAIL
ECHO STEP 3: Copy and verify Release 3.5.2b kernel.
B352BCPY.COM
IF ERRORLEVEL 1 GOTO COPYFAIL
ECHO STEP 4: Capture interrupt vectors.
IF EXIST INTS.BIN DEL INTS.BIN
IF EXIST INTS.BIN GOTO VECFAIL
MKINTS.COM
IF ERRORLEVEL 1 GOTO VECFAIL
IF NOT EXIST INTS.BIN GOTO VECFAIL
ECHO STEP 5: Start ELKS.
BTGVDX.COM
GOTO END
:MISSING
ECHO Required boot file missing in C:\ELKS352B.
ECHO Copy the complete ELKS352B folder from the standalone ZIP to C:.
GOTO END
:SNAPFAIL
ECHO STEP 2 FAILED: snapshot or log write. ELKS not started.
ECHO Check HPSNAP.COM and free space on C:.
GOTO END
:COPYFAIL
ECHO STEP 3 FAILED: kernel copy/readback. ELKS not started.
GOTO END
:VECFAIL
ECHO STEP 4 FAILED: interrupt capture. ELKS not started.
:END
